{
  "schema_version": "0.2",
  "purpose": "development_handoff_only_not_product_runtime_policy",
  "verified_documentation_date": "2026-10-27",
  "primary": {
    "model": "gpt-6-astra",
    "model_reasoning_effort": "medium"
  },
  "default_subagent": {
    "model": "gpt-6.1-sol",
    "model_reasoning_effort": "medium"
  },
  "max_concurrent_threads_per_session": 3,
  "roles": [
    {
      "name": "rcac_architect",
      "model": "gpt-6-astra",
      "model_reasoning_effort": "high",
      "sandbox_mode": "read-only",
      "config_file": ".codex/agents/rcac_architect.toml"
    },
    {
      "name": "rcac_explorer",
      "model": "gpt-6.1-sol",
      "model_reasoning_effort": "high",
      "sandbox_mode": "read-only",
      "config_file": ".codex/agents/rcac_explorer.toml"
    },
    {
      "name": "rcac_implementer",
      "model": "gpt-6.1-sol",
      "model_reasoning_effort": "medium",
      "sandbox_mode": "workspace-write",
      "config_file": ".codex/agents/rcac_implementer.toml"
    },
    {
      "name": "rcac_reviewer",
      "model": "gpt-6-astra",
      "model_reasoning_effort": "high",
      "sandbox_mode": "read-only",
      "config_file": ".codex/agents/rcac_reviewer.toml"
    },
    {
      "name": "rcac_verifier",
      "model": "gpt-6.1-sol",
      "model_reasoning_effort": "high",
