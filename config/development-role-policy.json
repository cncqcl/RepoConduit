    },
    {
      "name": "rcac_docs",
      "model": "gpt-6.1-terra",
      "model_reasoning_effort": "high",
      "sandbox_mode": "workspace-write",
      "config_file": ".codex/agents/rcac_docs.toml"
    },
    {
      "name": "rcac_visual",
      "model": "gpt-6.1-terra",
      "model_reasoning_effort": "high",
      "config_file": ".codex/agents/rcac_visual.toml"
    },
    {
      "name": "rcac_deep_reviewer",
      "model": "gpt-6-astra",
      "model_reasoning_effort": "xhigh",
      "sandbox_mode": "read-only",
      "config_file": ".codex/agents/rcac_deep_reviewer.toml"
